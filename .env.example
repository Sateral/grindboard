# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth secret (generate one with `npx @better-auth/cli secret`).
BETTER_AUTH_SECRET=

# Public origin of the app, e.g. https://grindboard.vercel.app. In local dev you
# may leave it empty; Better Auth derives the origin from the request.
BETTER_AUTH_URL=

# GitHub OAuth app (create at https://github.com/settings/developers).
# Authorized callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (create at https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
